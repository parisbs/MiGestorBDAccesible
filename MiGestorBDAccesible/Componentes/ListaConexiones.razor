@inject AlmacenConexionesService almacen
@inject AnunciadorService anunciador

<h1 tabindex="-1" @ref="_titulo">Conexiones</h1>

@if (_conexiones is null)
{
    <p>Cargando conexiones…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_avisoCarga))
    {
        <p>@_avisoCarga</p>
    }

    @if (_conexiones.Count == 0 && string.IsNullOrEmpty(_avisoCarga))
    {
        <p>Todavía no tienes conexiones guardadas. Crea la primera con el botón Nueva conexión.</p>
    }
    else if (_conexiones.Count > 0)
    {
        <ul class="lista-conexiones" aria-label="Conexiones guardadas">
            @foreach (var conexion in _conexiones)
            {
                <li>
                    <h2>@conexion.Nombre</h2>
                    <p class="detalle">@conexion.Resumen</p>

                    @if (_pendienteEliminar?.Id == conexion.Id)
                    {
                        <p>¿Seguro que quieres eliminar la conexión @conexion.Nombre? Solo se borra de esta lista; la base de datos no cambia.</p>
                        <div class="acciones">
                            <button class="peligro" @ref="_botonConfirmar" @onclick="() => EliminarAsync(conexion)">Sí, eliminar</button>
                            <button @onclick="CancelarEliminacion">Cancelar</button>
                        </div>
                    }
                    else
                    {
                        <div class="acciones">
                            <button class="principal" disabled="@Conectando"
                                    aria-label="Conectar a @conexion.Nombre"
                                    @onclick="() => AlConectar.InvokeAsync(conexion)">Conectar</button>
                            <button aria-label="Editar @conexion.Nombre"
                                    @onclick="() => AlEditar.InvokeAsync(conexion)">Editar</button>
                            <button class="peligro" aria-label="Eliminar @conexion.Nombre"
                                    @onclick="() => PedirEliminacion(conexion)">Eliminar</button>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <div class="acciones">
        <button class="principal" @onclick="AlCrear">Nueva conexión</button>
    </div>
}

@code {
    [Parameter] public string? Aviso { get; set; }
    [Parameter] public bool Conectando { get; set; }
    [Parameter] public EventCallback AlCrear { get; set; }
    [Parameter] public EventCallback<ConexionModelo> AlEditar { get; set; }
    [Parameter] public EventCallback<ConexionModelo> AlConectar { get; set; }

    private List<ConexionModelo>? _conexiones;
    private string? _avisoCarga;
    private bool _tituloEnfocado;
    private bool _cargaAnunciada;
    private ConexionModelo? _pendienteEliminar;
    private bool _enfocarConfirmacion;
    private ElementReference _titulo;
    private ElementReference _botonConfirmar;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var resultado = await almacen.CargarAsync();
        _conexiones = resultado.Conexiones;
        _avisoCarga = AlmacenConexionesService.DescribirCarga(resultado);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _titulo.FocusAsync();
            _tituloEnfocado = true;
        }

        if (_tituloEnfocado && _conexiones is not null && !_cargaAnunciada)
        {
            _cargaAnunciada = true;
            var mensaje = string.Join(" ", new[] { Aviso, _avisoCarga }.Where(aviso => !string.IsNullOrEmpty(aviso)));
            if (!string.IsNullOrEmpty(mensaje))
            {
                await AnunciarTrasFocoAsync(mensaje);
            }
        }

        if (_enfocarConfirmacion)
        {
            _enfocarConfirmacion = false;
            await _botonConfirmar.FocusAsync();
        }
    }

    private void PedirEliminacion(ConexionModelo conexion)
    {
        _pendienteEliminar = conexion;
        _enfocarConfirmacion = true;
    }

    private async Task CancelarEliminacion()
    {
        _pendienteEliminar = null;
        await _titulo.FocusAsync();
    }

    private async Task EliminarAsync(ConexionModelo conexion)
    {
        try
        {
            await almacen.EliminarAsync(conexion.Id);
        }
        catch (Exception error) when (error is System.IO.IOException or UnauthorizedAccessException)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo eliminar la conexión. {error.Message}");
            return;
        }

        _pendienteEliminar = null;
        await CargarAsync();

        StateHasChanged();
        await _titulo.FocusAsync();
        await AnunciarTrasFocoAsync($"Conexión {conexion.Nombre} eliminada. Quedan {_conexiones!.Count}. {_avisoCarga}");
    }

    private async Task AnunciarTrasFocoAsync(string mensaje)
    {
        await Task.Delay(600);
        await anunciador.AnunciarAsync(mensaje);
    }
}
