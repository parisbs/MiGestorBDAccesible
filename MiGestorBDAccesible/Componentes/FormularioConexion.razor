@using MiGestorBDAccesible.Modelos
@inject AlmacenConexionesService almacen
@inject ProveedoresService proveedores
@inject AnunciadorService anunciador

<h1 tabindex="-1" @ref="_titulo">@(EsNueva ? "Nueva conexión" : $"Editar conexión {Conexion!.Nombre}")</h1>

<EditForm EditContext="_contexto" OnValidSubmit="GuardarAsync" OnInvalidSubmit="AnunciarErroresAsync">
    <DataAnnotationsValidator />

    <div class="campo">
        <label for="nombre">Nombre de la conexión</label>
        <InputText id="nombre" @bind-Value="_formulario.Nombre" aria-describedby="ayuda-nombre" />
        <span id="ayuda-nombre" class="ayuda">Por ejemplo: Práctica Docker.</span>
        <ValidationMessage For="() => _formulario.Nombre" />
    </div>

    <div class="campo">
        <label for="motor">Motor de base de datos</label>
        <InputSelect id="motor" TValue="TipoMotor" Value="_formulario.Motor"
                     ValueChanged="CambiarMotor" ValueExpression="() => _formulario.Motor">
            @foreach (var motor in Enum.GetValues<TipoMotor>())
            {
                var disponible = proveedores.EstaDisponible(motor);
                <option value="@motor" disabled="@(!disponible)">
                    @(disponible ? motor.Nombre() : $"{motor.Nombre()} (próximamente)")
                </option>
            }
        </InputSelect>
    </div>

    <div class="campo">
        <label for="servidor">Servidor</label>
        <InputText id="servidor" @bind-Value="_formulario.Servidor" aria-describedby="ayuda-servidor" />
        <span id="ayuda-servidor" class="ayuda">Nombre o dirección del equipo. Para Docker o tu propio equipo: localhost.</span>
        <ValidationMessage For="() => _formulario.Servidor" />
    </div>

    <div class="campo">
        <label for="puerto">Puerto</label>
        <InputNumber id="puerto" @bind-Value="_formulario.Puerto" aria-describedby="ayuda-puerto" />
        <span id="ayuda-puerto" class="ayuda">El de @_formulario.Motor.Nombre() es @_formulario.Motor.PuertoPredeterminado(). Déjalo vacío para usar una instancia con nombre.</span>
        <ValidationMessage For="() => _formulario.Puerto" />
    </div>

    @if (_formulario.Motor.UsaNombreServicio())
    {
        <div class="campo">
            <label for="servicio">Nombre de servicio</label>
            <InputText id="servicio" @bind-Value="_formulario.NombreServicio" aria-describedby="ayuda-servicio" />
            <span id="ayuda-servicio" class="ayuda">En Oracle Free es FREEPDB1, la base de datos conectable donde están los esquemas de usuario.</span>
            <ValidationMessage For="() => _formulario.NombreServicio" />
        </div>
    }

    @if (_formulario.Motor.AdmiteAutenticacionWindows())
    {
        <fieldset>
            <legend>Autenticación</legend>
            <InputRadioGroup @bind-Value="_formulario.Autenticacion">
                <div class="campo casilla">
                    <InputRadio id="aut-usuario" Value="TipoAutenticacion.UsuarioYContrasena" />
                    <label for="aut-usuario">Usuario y contraseña de SQL Server</label>
                </div>
                <div class="campo casilla">
                    <InputRadio id="aut-windows" Value="TipoAutenticacion.Windows" />
                    <label for="aut-windows">Autenticación de Windows</label>
                </div>
            </InputRadioGroup>
        </fieldset>
    }

    @if (_formulario.Autenticacion == TipoAutenticacion.UsuarioYContrasena)
    {
        <div class="campo">
            <label for="usuario">Usuario</label>
            <InputText id="usuario" @bind-Value="_formulario.Usuario" autocomplete="off" />
            <ValidationMessage For="() => _formulario.Usuario" />
        </div>

        <div class="campo">
            <label for="contrasena">Contraseña</label>
            <InputText id="contrasena" type="password" @bind-Value="_formulario.Contrasena"
                       autocomplete="off" aria-describedby="ayuda-contrasena" />
            <span id="ayuda-contrasena" class="ayuda">
                @(_formulario.TieneContrasenaGuardada
                    ? "Hay una contraseña guardada. Déjala vacía para conservarla."
                    : "Se guarda cifrada con tu usuario de Windows.")
            </span>
            <ValidationMessage For="() => _formulario.Contrasena" />
        </div>
    }

    @if (_formulario.Motor == TipoMotor.SqlServer)
    {
        <div class="campo casilla">
            <InputCheckbox id="confiar" @bind-Value="_formulario.ConfiarCertificado" aria-describedby="ayuda-confiar" />
            <label for="confiar">Confiar en el certificado del servidor</label>
        </div>
        <p id="ayuda-confiar" class="ayuda">Márcala para servidores locales o de prueba, como Docker.</p>
    }

    @if (_formulario.Motor.AdmiteBaseInicial())
    {
        <div class="campo">
            <label for="base-inicial">Base de datos inicial (opcional)</label>
            <InputText id="base-inicial" @bind-Value="_formulario.BaseDatosInicial" aria-describedby="ayuda-base" />
            <span id="ayuda-base" class="ayuda">@(_formulario.Motor.BaseInicialPredeterminada() is { } predeterminada
                ? $"PostgreSQL siempre se conecta a una base; desde ella se ven las demás. Si la dejas vacía se usa {predeterminada}."
                : "Si la dejas vacía se usa la base predeterminada del usuario.")</span>
        </div>
    }

    <div class="acciones">
        <button type="button" disabled="@_probando" @onclick="ProbarAsync">Probar conexión</button>
        <button type="submit" class="principal" disabled="@_probando">Guardar</button>
        <button type="button" @onclick="() => AlTerminar.InvokeAsync(null)">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter] public ConexionModelo? Conexion { get; set; }
    [Parameter] public EventCallback<string?> AlTerminar { get; set; }

    private bool EsNueva => Conexion is null;

    private FormularioConexionModelo _formulario = new();
    private EditContext _contexto = default!;
    private ElementReference _titulo;
    private bool _probando;

    protected override void OnInitialized()
    {
        _formulario = Conexion is null ? new() : FormularioConexionModelo.Desde(Conexion);
        _contexto = new EditContext(_formulario);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _titulo.FocusAsync();
        }
    }

    private void CambiarMotor(TipoMotor motor)
    {
        var puertoAnterior = _formulario.Motor.PuertoPredeterminado();

        if (_formulario.Puerto is null || _formulario.Puerto == puertoAnterior)
        {
            _formulario.Puerto = motor.PuertoPredeterminado();
        }

        if (!motor.AdmiteAutenticacionWindows())
        {
            _formulario.Autenticacion = TipoAutenticacion.UsuarioYContrasena;
        }

        if (motor.UsaNombreServicio() && string.IsNullOrWhiteSpace(_formulario.NombreServicio))
        {
            _formulario.NombreServicio = motor.ServicioPredeterminado();
        }

        if (string.IsNullOrWhiteSpace(_formulario.BaseDatosInicial) || _formulario.BaseDatosInicial == _formulario.Motor.BaseInicialPredeterminada())
        {
            _formulario.BaseDatosInicial = motor.BaseInicialPredeterminada();
        }

        _formulario.Motor = motor;
    }

    private async Task ProbarAsync()
    {
        if (!_contexto.Validate())
        {
            await AnunciarErroresAsync();
            return;
        }

        _probando = true;
        await anunciador.AnunciarAsync("Probando conexión…");

        var prueba = new ConexionModelo();
        _formulario.AplicarA(prueba);

        var contrasena = string.IsNullOrEmpty(_formulario.Contrasena) && Conexion is not null
            ? AlmacenConexionesService.ObtenerContrasena(Conexion)
            : _formulario.Contrasena;

        var resultado = await proveedores.Obtener(prueba.Motor).ProbarConexionAsync(prueba, contrasena);

        _probando = false;

        if (resultado.Exito)
        {
            await anunciador.AnunciarAsync(
                $"{resultado.Producto}, {resultado.Edicion}, versión {resultado.Version}. " +
                $"Respondió en {resultado.Duracion.TotalMilliseconds:N0} milisegundos. " +
                (resultado.Advertencia is null ? "" : $"{resultado.Advertencia} ") +
                "Conexión correcta.");
        }
        else
        {
            await anunciador.AnunciarUrgenteAsync($"Error al conectar. {resultado.Error}");
        }
    }

    private async Task GuardarAsync()
    {
        var conexion = Conexion ?? new ConexionModelo();
        _formulario.AplicarA(conexion);

        try
        {
            await almacen.GuardarAsync(conexion, _formulario.Contrasena);
        }
        catch (Exception error) when (error is System.IO.IOException or UnauthorizedAccessException)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo guardar la conexión. Tus datos siguen en el formulario. {error.Message}");
            return;
        }

        await AlTerminar.InvokeAsync($"Conexión {conexion.Nombre} guardada.");
    }

    private async Task AnunciarErroresAsync()
    {
        var errores = _contexto.GetValidationMessages().ToList();
        var resumen = errores.Count == 1 ? "Falta 1 dato" : $"Faltan {errores.Count} datos";

        await anunciador.AnunciarUrgenteAsync($"{string.Join(" ", errores)} {resumen}.");
    }
}
