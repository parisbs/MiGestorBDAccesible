<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Fijado al SDK 26 para compilar con Xcode 26; el 27 exige Xcode 27.1. -->
    <TargetFramework>net10.0-macos26.0</TargetFramework>
    <!-- Xcode 26.5 con el SDK 26.0: se omite la comprobación exacta de versión. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <RootNamespace>PrototipoMacAppKit</RootNamespace>
    <ApplicationTitle>Prototipo AppKit Mi Gestor BD Accesible</ApplicationTitle>
    <ApplicationId>io.github.parisbs.prototipomigestorbdappkit</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.14.26531.2" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.14.26531.2" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.BlazorWebView" Version="0.1.0-preview.14.26531.2" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- El app.js real del programa, enlazado sin copiarlo (issue 10). -->
    <BundleResource Include="..\..\MiGestorBDAccesible\wwwroot\js\app.js" Link="wwwroot\js\app.js" />
  </ItemGroup>

</Project>
